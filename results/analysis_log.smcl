. /*----------------------------------------------------------------------
>   SECTION 8: ROBUSTNESS - E-VALUE SENSITIVITY ANALYSIS
> ----------------------------------------------------------------------*/
. 
. display _n "=== Robustness: E-value ==="
{res}
=== Robustness: E-value ===
{txt}
{com}. 
. * Compute E-value from primary regression coefficient
. * Using point estimate and CI lower bound from H1
. estimates restore h1_primary
{txt}(results {stata estimates replay h1_primary:h1_primary} are active now)

{com}. local b_exp = _b[Exposure_T2]
{txt}
{com}. local se_exp = _se[Exposure_T2]
{txt}
{com}. local ci_lo = `b_exp' - 1.96 * `se_exp'
{txt}
{com}. 
. * E-value formula (for continuous outcome, approximate via RR conversion)
. * RR ≈ exp(0.91 * beta / SD_Y) per VanderWeele & Ding (2017)
. quietly summarize IPB1_T2
{txt}
{com}. local sd_y = r(sd)
{txt}
{com}. local RR = exp(0.91 * `b_exp' / `sd_y')
{txt}
{com}. local E_point = `RR' + sqrt(`RR' * (`RR' - 1))
{txt}
{com}. local RR_lo = exp(0.91 * `ci_lo' / `sd_y')
{txt}
{com}. local E_ci = `RR_lo' + sqrt(`RR_lo' * (`RR_lo' - 1))
{txt}
{com}. 
. display "E-value (point estimate): " %6.3f `E_point'
{res}E-value (point estimate):  1.841
{txt}
{com}. display "E-value (CI lower bound): " %6.3f `E_ci'
{res}E-value (CI lower bound):  1.291
{txt}
{com}. 
