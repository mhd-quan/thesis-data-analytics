. * Export mediation paths table
. esttab a_PS_T2 a_PSI_T2 a_EA_T2 a_SP_T2 outcome_model ///
>     using "results/table4_H2_mediation_paths.csv", replace ///
>     star(* 0.10 ** 0.05 *** 0.01) ///
>     b(%9.3f) se(%9.3f) ///
>     title("Table 4: H2 — Mediation a-paths and Outcome Model") ///
>     mtitles("a: PS" "a: PSI" "a: EA" "a: SP" "Outcome") ///
>     note("Robust standard errors in parentheses")
{res}{txt}{p 0 4 2}
(file {bf}
results/table4_H2_mediation_paths.csv{rm}
not found)
{p_end}
(output written to {browse  `"results/table4_H2_mediation_paths.csv"'})

{com}. 
. * 5.3 Bootstrap indirect effects
. capture program drop boot_mediation
{txt}
{com}. program define boot_mediation, rclass
{txt}  1{com}.     * a-paths
.     quietly regress PS_T2 Exposure_T2 IPB1 IBT_mean SC_mean age i.gender
{txt}  2{com}.     local a1 = _b[Exposure_T2]
{txt}  3{com}.     quietly regress PSI_T2 Exposure_T2 IPB1 IBT_mean SC_mean age i.gender
{txt}  4{com}.     local a2 = _b[Exposure_T2]
{txt}  5{com}.     quietly regress EA_T2 Exposure_T2 IPB1 IBT_mean SC_mean age i.gender
{txt}  6{com}.     local a3 = _b[Exposure_T2]
{txt}  7{com}.     quietly regress SP_T2 Exposure_T2 IPB1 IBT_mean SC_mean age i.gender
{txt}  8{com}.     local a4 = _b[Exposure_T2]
{txt}  9{com}.     
.     * Outcome model (b-paths)
.     quietly regress IPB1_T2 Exposure_T2 PS_T2 PSI_T2 EA_T2 SP_T2 ///
>                     IPB1 IBT_mean SC_mean age i.gender MA_T2_mean TA_T2_mean MOOD1_T2
{txt} 10{com}.     local b1 = _b[PS_T2]
{txt} 11{com}.     local b2 = _b[PSI_T2]
{txt} 12{com}.     local b3 = _b[EA_T2]
{txt} 13{com}.     local b4 = _b[SP_T2]
{txt} 14{com}.     local cprime = _b[Exposure_T2]
{txt} 15{com}.     
.     * Indirect effects
.     return scalar ind_ps = `a1' * `b1'
{txt} 16{com}.     return scalar ind_psi = `a2' * `b2'
{txt} 17{com}.     return scalar ind_ea = `a3' * `b3'
{txt} 18{com}.     return scalar ind_sp = `a4' * `b4'
{txt} 19{com}.     return scalar total_indirect = `a1'*`b1' + `a2'*`b2' + `a3'*`b3' + `a4'*`b4'
{txt} 20{com}.     return scalar direct = `cprime'
{txt} 21{com}.     return scalar total = `cprime' + `a1'*`b1' + `a2'*`b2' + `a3'*`b3' + `a4'*`b4'
{txt} 22{com}.     
.     * Contrasts
.     return scalar contrast_ps_psi = `a1'*`b1' - `a2'*`b2'
{txt} 23{com}.     return scalar contrast_ps_ea = `a1'*`b1' - `a3'*`b3'
{txt} 24{com}.     return scalar contrast_psi_sp = `a2'*`b2' - `a4'*`b4'
{txt} 25{com}. end
{txt}
{com}. 
. bootstrap r(ind_ps) r(ind_psi) r(ind_ea) r(ind_sp) ///
>           r(total_indirect) r(direct) r(total) ///
>           r(contrast_ps_psi) r(contrast_ps_ea) r(contrast_psi_sp), ///
>           reps(5000) seed(2026): boot_mediation
{res}{txt}(running {bf:boot_mediation} on estimation sample)
